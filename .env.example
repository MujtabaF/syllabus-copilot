# Copy to .env and fill in. Never commit .env.

# Any LiteLLM model string works: https://docs.litellm.ai/docs/providers
#   gemini/gemini-2.5-flash   (free tier via Google AI Studio)
#   groq/llama-3.3-70b-versatile
#   ollama/llama3.1           (local, no key needed)
LLM_MODEL=gemini/gemini-2.5-flash

# Only the key for the provider you use is required.
GEMINI_API_KEY=
GROQ_API_KEY=

DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
